// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String?             @unique
  name              String?
  number            String              @unique
  password          String
  OnRampTransaction OnRampTransaction[]
  Account           UserAccount[]
  P2PsentTxns       P2PTransfer[]       @relation(name: "senderRelation")
  P2PreceivedTxns   P2PTransfer[]       @relation(name: "receiverRelation")
}

model P2PTransfer {
  id        String   @id @default(uuid())
  amount    Int
  timeStamp DateTime
  fromUser  String
  toUser    String
  sender    User     @relation(name: "senderRelation", fields: [fromUser], references: [number])
  receiver  User     @relation(name: "receiverRelation", fields: [toUser], references: [number])
}

model Merchant {
  id       String            @id @default(uuid())
  name     String?
  phone    String?           @unique
  email    String            @unique
  password String
  account  MerchantAccount[]
}

model OnRampTransaction {
  id              String                   @id @default(uuid())
  status          OnRampStatus
  token           String                   @unique
  provider        String
  amount          Int
  startTime       DateTime
  userId          String
  user            User                     @relation(fields: [userId], references: [id])
  onRampTxnOutbox OnRampTransactionOutbox?
}

model UserAccount {
  id      String @id @default(uuid())
  userId  String @unique
  balance Int    @default(0)
  locked  Int    @default(0)
  user    User   @relation(fields: [userId], references: [id])
}

model MerchantAccount {
  id         String   @id @default(uuid())
  balance    Int      @default(0)
  locked     Int      @default(0)
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])
}

model OnRampTransactionOutbox {
  id          String            @id @default(uuid())
  onRampTxnId String            @unique
  onRampTxn   OnRampTransaction @relation(fields: [onRampTxnId], references: [id])
}

enum AuthType {
  Google
  Github
}

enum OnRampStatus {
  Success
  Failure
  Processing
}
